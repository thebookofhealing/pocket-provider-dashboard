{
  "name": "pocket-dashboard",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3100",
    "ingest": "tsx scripts/ingest.ts",
    "worker": "tsx scripts/ingest.ts --watch",
    "indexer": "tsx scripts/indexer.ts --live",
    "indexer:once": "tsx scripts/indexer.ts --once",
    "indexer:backfill": "tsx scripts/indexer.ts --backfill 45d",
    "test:protocol": "bash scripts/test-protocol.sh",
    "test:node24": "bash scripts/test-node24-migration.sh",
    "test:runtime": "bash scripts/test-node24-runtime.sh",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "better-sqlite3": "13.0.3",
    "next": "^15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "^4.21.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
